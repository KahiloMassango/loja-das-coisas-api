# ========================================================
# Environment Variables for Dokploy & Local Docker Compose
# ========================================================

# Spring Profile ('dev' for local SQLite, 'prod' for PostgreSQL / Dokploy)
SPRING_PROFILES_ACTIVE=prod

# Server Port
PORT=8080

# Database Configuration (PostgreSQL in Dokploy or Docker Compose)
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/storedb
SPRING_DATASOURCE_USERNAME=superUser
SPRING_DATASOURCE_PASSWORD=secret
SPRING_JPA_HIBERNATE_DDL_AUTO=update

# Uploads directory (mounted to persistent volume on Dokploy: /app/uploads)
FILE_UPLOAD_DIR=/app/uploads

# Base URL for public image URLs (e.g. https://api.yourdomain.com)
APP_BASE_URL=http://localhost:8080

# CORS Allowed Origins (comma-separated or * for all)
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:3000

# Security JWT Key (Change this in production)
JWT_KEY="EgZjaHJvbWUqBwgCECEYoAEyBggAEEUYOTIHCAEQIRigATIHCAIQIRigATIHCAMQIRigATIHCAQQIRigATIHCAUQIRigATIHCAYQIRiPAjIHCAcQIRiPAtIBCDQwOTNqMGo3qAIAsAIA"

# Optional: Firebase Credentials (if using push notifications)
# Option 1: File path (e.g., mounted via Dokploy volume):
# FIREBASE_CREDENTIALS_PATH=/app/serviceAccountKey.json
# Option 2: Raw or base64-encoded JSON string:
# FIREBASE_CREDENTIALS_JSON=
